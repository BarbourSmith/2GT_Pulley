      "interpreterVersion": 1,
      "code": "/**\n * 2GT (GT2) timing-belt pulley — same droftarts/0scar tooth data, but\n * the tooth flanks are fit with smooth splines instead of polylines.\n *\n * The curve runs from index 1 (right base) through index 21 (left base)\n * with the peak at index 11. We subsample to 9 points along that curve\n * (denser near the peak, where curvature is highest) and feed each\n * spline an analytic tangent computed by central-difference on the\n * ORIGINAL 21-point data — that way each sub-spline only has to fit a\n * smooth slice of the underlying GT2 curve, where a cubic Bezier is\n * essentially exact.\n *\n * The bottom guard rectangle (points 0, 1, 21, 22) stays as straight\n * line segments so its right-angle corners remain sharp.\n */\nfunction run(numberOfTeeth: number = 20, faceWidth: number = 6) {\n  const N = Math.max(8, Math.round(numberOfTeeth));\n  const pitch = 2.0;\n  const PLD = 0.254;\n  const toothWidth = 1.494;\n\n  const pitchR = (N * pitch) / (2 * Math.PI);\n  const outerR = pitchR - PLD;\n  const d = Math.sqrt(outerR ** 2 - (toothWidth / 2) ** 2);\n\n  // 23-point GT2 belt-tooth polygon (Gates dxf data, via droftarts/0scar).\n  const TOOTH_PTS: [number, number][] = [\n    [0.747183, -0.5], [0.747183, 0],\n    [0.647876, 0.037218], [0.598311, 0.130528],\n    [0.578556, 0.238423], [0.547158, 0.343077],\n    [0.504649, 0.443762], [0.451556, 0.53975],\n    [0.358229, 0.636924], [0.2484, 0.707276],\n    [0.127259, 0.750044], [0, 0.76447],\n    [-0.127259, 0.750044], [-0.2484, 0.707276],\n    [-0.358229, 0.636924], [-0.451556, 0.53975],\n    [-0.504797, 0.443762], [-0.547291, 0.343077],\n    [-0.578605, 0.238423], [-0.598311, 0.130528],\n    [-0.648009, 0.037218], [-0.747183, 0],\n    [-0.747183, -0.5],\n  ];\n\n  // Tangent at index i, computed from the original (dense) data.\n  // Endpoints of the curve segment use one-sided differences so they\n  // don't pick up the guard-rectangle direction.\n  const tangentAt = (i: number): [number, number] => {\n    let dx, dy;\n    if (i === 1) {\n      [dx, dy] = [TOOTH_PTS[2][0] - TOOTH_PTS[1][0], TOOTH_PTS[2][1] - TOOTH_PTS[1][1]];\n    } else if (i === 21) {\n      [dx, dy] = [TOOTH_PTS[21][0] - TOOTH_PTS[20][0], TOOTH_PTS[21][1] - TOOTH_PTS[20][1]];\n    } else {\n      [dx, dy] = [TOOTH_PTS[i + 1][0] - TOOTH_PTS[i - 1][0], TOOTH_PTS[i + 1][1] - TOOTH_PTS[i - 1][1]];\n    }\n    const len = Math.hypot(dx, dy) || 1;\n    return [dx / len, dy / len];\n  };\n\n  // Subsampled indices along the curve. Sparser on flanks, denser near peak.\n  const SUB = [1, 4, 7, 9, 11, 13, 15, 18, 21];\n\n  const buildTooth = () => {\n    let pen = replicad.draw(TOOTH_PTS[0]);\n    pen = pen.lineTo(TOOTH_PTS[1]);                       // right guard (vertical)\n\n    for (let k = 1; k < SUB.length; k++) {\n      const iA = SUB[k - 1], iB = SUB[k];\n      pen = pen.smoothSplineTo(TOOTH_PTS[iB], {\n        startTangent: tangentAt(iA),\n        endTangent: tangentAt(iB),\n      });\n    }\n\n    pen = pen.lineTo(TOOTH_PTS[22]);                      // left guard (vertical)\n    return pen.close();                                   // bottom guard (horizontal)\n  };\n\n  let pulley2D = replicad.drawCircle(outerR);\n  for (let i = 0; i < N; i++) {\n    const angleDeg = (i * 360) / N;\n    const tooth = buildTooth().translate(0, -d).rotate(angleDeg, [0, 0]);\n    pulley2D = pulley2D.cut(tooth);\n  }\n\n  return pulley2D.sketchOnPlane().extrude(faceWidth);\n}",
      "compiledCode": "\"use strict\";\n/**\n * 2GT (GT2) timing-belt pulley — same droftarts/0scar tooth data, but\n * the tooth flanks are fit with smooth splines instead of polylines.\n *\n * The curve runs from index 1 (right base) through index 21 (left base)\n * with the peak at index 11. We subsample to 9 points along that curve\n * (denser near the peak, where curvature is highest) and feed each\n * spline an analytic tangent computed by central-difference on the\n * ORIGINAL 21-point data — that way each sub-spline only has to fit a\n * smooth slice of the underlying GT2 curve, where a cubic Bezier is\n * essentially exact.\n *\n * The bottom guard rectangle (points 0, 1, 21, 22) stays as straight\n * line segments so its right-angle corners remain sharp.\n */\nfunction run(numberOfTeeth = 20, faceWidth = 6) {\n    const N = Math.max(8, Math.round(numberOfTeeth));\n    const pitch = 2.0;\n    const PLD = 0.254;\n    const toothWidth = 1.494;\n    const pitchR = (N * pitch) / (2 * Math.PI);\n    const outerR = pitchR - PLD;\n    const d = Math.sqrt(outerR ** 2 - (toothWidth / 2) ** 2);\n    // 23-point GT2 belt-tooth polygon (Gates dxf data, via droftarts/0scar).\n    const TOOTH_PTS = [\n        [0.747183, -0.5], [0.747183, 0],\n        [0.647876, 0.037218], [0.598311, 0.130528],\n        [0.578556, 0.238423], [0.547158, 0.343077],\n        [0.504649, 0.443762], [0.451556, 0.53975],\n        [0.358229, 0.636924], [0.2484, 0.707276],\n        [0.127259, 0.750044], [0, 0.76447],\n        [-0.127259, 0.750044], [-0.2484, 0.707276],\n        [-0.358229, 0.636924], [-0.451556, 0.53975],\n        [-0.504797, 0.443762], [-0.547291, 0.343077],\n        [-0.578605, 0.238423], [-0.598311, 0.130528],\n        [-0.648009, 0.037218], [-0.747183, 0],\n        [-0.747183, -0.5],\n    ];\n    // Tangent at index i, computed from the original (dense) data.\n    // Endpoints of the curve segment use one-sided differences so they\n    // don't pick up the guard-rectangle direction.\n    const tangentAt = (i) => {\n        let dx, dy;\n        if (i === 1) {\n            [dx, dy] = [TOOTH_PTS[2][0] - TOOTH_PTS[1][0], TOOTH_PTS[2][1] - TOOTH_PTS[1][1]];\n        }\n        else if (i === 21) {\n            [dx, dy] = [TOOTH_PTS[21][0] - TOOTH_PTS[20][0], TOOTH_PTS[21][1] - TOOTH_PTS[20][1]];\n        }\n        else {\n            [dx, dy] = [TOOTH_PTS[i + 1][0] - TOOTH_PTS[i - 1][0], TOOTH_PTS[i + 1][1] - TOOTH_PTS[i - 1][1]];\n        }\n        const len = Math.hypot(dx, dy) || 1;\n        return [dx / len, dy / len];\n    };\n    // Subsampled indices along the curve. Sparser on flanks, denser near peak.\n    const SUB = [1, 4, 7, 9, 11, 13, 15, 18, 21];\n    const buildTooth = () => {\n        let pen = replicad.draw(TOOTH_PTS[0]);\n        pen = pen.lineTo(TOOTH_PTS[1]); // right guard (vertical)\n        for (let k = 1; k < SUB.length; k++) {\n            const iA = SUB[k - 1], iB = SUB[k];\n            pen = pen.smoothSplineTo(TOOTH_PTS[iB], {\n                startTangent: tangentAt(iA),\n                endTangent: tangentAt(iB),\n            });\n        }\n        pen = pen.lineTo(TOOTH_PTS[22]); // left guard (vertical)\n        return pen.close(); // bottom guard (horizontal)\n    };\n    let pulley2D = replicad.drawCircle(outerR);\n    for (let i = 0; i < N; i++) {\n        const angleDeg = (i * 360) / N;\n        const tooth = buildTooth().translate(0, -d).rotate(angleDeg, [0, 0]);\n        pulley2D = pulley2D.cut(tooth);\n    }\n    return pulley2D.sketchOnPlane().extrude(faceWidth);\n}\n"
    }
  ],
