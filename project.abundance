      "interpreterVersion": 1,
      "code": "/**\n * 2GT (GT2) timing-belt pulley — port of the droftarts / 0scar OpenSCAD\n * pulley generator (https://www.thingiverse.com/0scar/about), focused\n * solely on the toothed body (no shaft hole, retainer, idler, flange,\n * grub-screw bores, etc.).\n *\n * The tooth profile below is the *belt* tooth polygon from Gates' GT2 dxf\n * data. We use it as a CUTTER: the polygon is positioned so its base\n * corners (at y = 0 in its local frame) land exactly on the pulley's OD\n * circle, and the tip of the polygon then dips inward into the pulley\n * body, carving a valley that matches the belt tooth's exact shape.\n */\nfunction run(numberOfTeeth: number = 20, faceWidth: number = 6) {\n  const N = Math.max(8, Math.round(numberOfTeeth));\n  const pitch = 2.0;\n  const PLD = 0.254;     // GT2 pitch-line offset (per Gates)\n  const toothWidth = 1.494;     // matches the polygon's base width below\n\n  const pitchR = (N * pitch) / (2 * Math.PI);\n  const outerR = pitchR - PLD;  // OD/2 = (PD − 2·PLD)/2\n\n  // Distance from the pulley centre to the polygon's local origin so that\n  // the polygon's base corners (x = ±toothWidth/2, y = 0) sit exactly on\n  // the OD circle. This is the OpenSCAD `tooth_distance_from_centre`.\n  const d = Math.sqrt(outerR ** 2 - (toothWidth / 2) ** 2);\n\n  // Belt tooth profile (one tooth) from droftarts/0scar pulley library.\n  // Local frame: x is tangential (along the pitch line), y points away\n  // from the belt back, with the tooth tip at the top (y ≈ +0.764).\n  // The lower rectangle (y from −0.5 to 0) is a guard-band that will be\n  // outside the OD circle once translated, so it never trims pulley\n  // material — it just guarantees a clean cut at the rim.\n  const TOOTH_PTS: [number, number][] = [\n    [0.747183, -0.5], [0.747183, 0],\n    [0.647876, 0.037218], [0.598311, 0.130528],\n    [0.578556, 0.238423], [0.547158, 0.343077],\n    [0.504649, 0.443762], [0.451556, 0.53975],\n    [0.358229, 0.636924], [0.2484, 0.707276],\n    [0.127259, 0.750044], [0, 0.76447],\n    [-0.127259, 0.750044], [-0.2484, 0.707276],\n    [-0.358229, 0.636924], [-0.451556, 0.53975],\n    [-0.504797, 0.443762], [-0.547291, 0.343077],\n    [-0.578605, 0.238423], [-0.598311, 0.130528],\n    [-0.648009, 0.037218], [-0.747183, 0],\n    [-0.747183, -0.5],\n  ];\n\n  const buildTooth = () => {\n    let pen = replicad.draw(TOOTH_PTS[0]);\n    for (let i = 1; i < TOOTH_PTS.length; i++) pen = pen.lineTo(TOOTH_PTS[i]);\n    return pen.close();\n  };\n\n  // Base disc, then cut N tooth-shaped valleys around the rim.\n  let pulley2D = replicad.drawCircle(outerR);\n  for (let i = 0; i < N; i++) {\n    const angleDeg = (i * 360) / N;\n    const tooth = buildTooth()\n      .translate(0, -d)              // park base corners on the OD circle (at angle −90°)\n      .rotate(angleDeg, [0, 0]);     // rotate to the i-th tooth position\n    pulley2D = pulley2D.cut(tooth);\n  }\n\n  return pulley2D.sketchOnPlane().extrude(faceWidth);\n}",
      "compiledCode": "\"use strict\";\n/**\n * 2GT (GT2) timing-belt pulley — port of the droftarts / 0scar OpenSCAD\n * pulley generator (https://www.thingiverse.com/0scar/about), focused\n * solely on the toothed body (no shaft hole, retainer, idler, flange,\n * grub-screw bores, etc.).\n *\n * The tooth profile below is the *belt* tooth polygon from Gates' GT2 dxf\n * data. We use it as a CUTTER: the polygon is positioned so its base\n * corners (at y = 0 in its local frame) land exactly on the pulley's OD\n * circle, and the tip of the polygon then dips inward into the pulley\n * body, carving a valley that matches the belt tooth's exact shape.\n */\nfunction run(numberOfTeeth = 20, faceWidth = 6) {\n    const N = Math.max(8, Math.round(numberOfTeeth));\n    const pitch = 2.0;\n    const PLD = 0.254; // GT2 pitch-line offset (per Gates)\n    const toothWidth = 1.494; // matches the polygon's base width below\n    const pitchR = (N * pitch) / (2 * Math.PI);\n    const outerR = pitchR - PLD; // OD/2 = (PD − 2·PLD)/2\n    // Distance from the pulley centre to the polygon's local origin so that\n    // the polygon's base corners (x = ±toothWidth/2, y = 0) sit exactly on\n    // the OD circle. This is the OpenSCAD `tooth_distance_from_centre`.\n    const d = Math.sqrt(outerR ** 2 - (toothWidth / 2) ** 2);\n    // Belt tooth profile (one tooth) from droftarts/0scar pulley library.\n    // Local frame: x is tangential (along the pitch line), y points away\n    // from the belt back, with the tooth tip at the top (y ≈ +0.764).\n    // The lower rectangle (y from −0.5 to 0) is a guard-band that will be\n    // outside the OD circle once translated, so it never trims pulley\n    // material — it just guarantees a clean cut at the rim.\n    const TOOTH_PTS = [\n        [0.747183, -0.5], [0.747183, 0],\n        [0.647876, 0.037218], [0.598311, 0.130528],\n        [0.578556, 0.238423], [0.547158, 0.343077],\n        [0.504649, 0.443762], [0.451556, 0.53975],\n        [0.358229, 0.636924], [0.2484, 0.707276],\n        [0.127259, 0.750044], [0, 0.76447],\n        [-0.127259, 0.750044], [-0.2484, 0.707276],\n        [-0.358229, 0.636924], [-0.451556, 0.53975],\n        [-0.504797, 0.443762], [-0.547291, 0.343077],\n        [-0.578605, 0.238423], [-0.598311, 0.130528],\n        [-0.648009, 0.037218], [-0.747183, 0],\n        [-0.747183, -0.5],\n    ];\n    const buildTooth = () => {\n        let pen = replicad.draw(TOOTH_PTS[0]);\n        for (let i = 1; i < TOOTH_PTS.length; i++)\n            pen = pen.lineTo(TOOTH_PTS[i]);\n        return pen.close();\n    };\n    // Base disc, then cut N tooth-shaped valleys around the rim.\n    let pulley2D = replicad.drawCircle(outerR);\n    for (let i = 0; i < N; i++) {\n        const angleDeg = (i * 360) / N;\n        const tooth = buildTooth()\n            .translate(0, -d) // park base corners on the OD circle (at angle −90°)\n            .rotate(angleDeg, [0, 0]); // rotate to the i-th tooth position\n        pulley2D = pulley2D.cut(tooth);\n    }\n    return pulley2D.sketchOnPlane().extrude(faceWidth);\n}\n"
    }
