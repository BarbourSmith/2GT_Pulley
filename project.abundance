      ],
      "interpreterVersion": 1,
      "code": "/**\n * 2GT timing-belt pulley — simplified CadQuery-style profile.\n *\n * Built from a base disc with N rectangular tooth-slots cut radially\n * around the rim, plus a central bore. This isn't the exact Gates\n * GT2 curvilinear profile, but it's a clean, common simplification\n * for 3D-printed pulleys.\n *\n *   PD = N · 2 / π\n *   OD = PD − 0.5            (slightly different PLD convention than Gates' 0.508)\n *   each slot: 1.2 mm wide tangentially × 0.75 mm deep radially, centered\n *   at the pitch radius.\n */\nfunction run(\n  numberOfTeeth: number = 20,\n  faceWidth: number = 6.5,\n  boreDia: number = 5.0,\n) {\n  const N = Math.max(8, Math.round(numberOfTeeth));\n  const pitch = 2.0;\n  const bottomWidth = 1.2;     // tangential slot width\n  const toothDepth = 0.75;    // radial slot depth\n  const ODoffset = 0.5;     // OD = PD − 0.5\n\n  const pitchR = (N * pitch) / (2 * Math.PI);\n  const outerR = pitchR - ODoffset / 2;     // OD/2\n\n  // Base disc.\n  let pulley2D = replicad.drawCircle(outerR);\n\n  // Rectangular tooth slot in its un-rotated frame:\n  //   X axis (radial)    : spans [outerR − toothDepth, outerR + ε]\n  //   Y axis (tangential): spans [−bottomWidth/2, +bottomWidth/2]\n  // ε on the outer side so the cut cleanly breaks the disc boundary.\n  const epsilon = 0.05;\n  const slotLength = toothDepth + epsilon;\n  const slotCenterX = outerR + epsilon / 2 - toothDepth / 2;\n\n  for (let i = 0; i < N; i++) {\n    const thetaDeg = (i * 360) / N;\n    const slot = replicad\n      .drawRectangle(slotLength, bottomWidth)   // centered at origin\n      .translate(slotCenterX, 0)                // park it straddling the rim at angle 0\n      .rotate(thetaDeg, [0, 0]);                // rotate around centre to position i\n    pulley2D = pulley2D.cut(slot);\n  }\n\n  // Center bore for the motor shaft.\n  if (boreDia > 0) {\n    pulley2D = pulley2D.cut(replicad.drawCircle(boreDia / 2));\n  }\n\n  return pulley2D.sketchOnPlane().extrude(faceWidth);\n}",
      "compiledCode": "\"use strict\";\n/**\n * 2GT timing-belt pulley — simplified CadQuery-style profile.\n *\n * Built from a base disc with N rectangular tooth-slots cut radially\n * around the rim, plus a central bore. This isn't the exact Gates\n * GT2 curvilinear profile, but it's a clean, common simplification\n * for 3D-printed pulleys.\n *\n *   PD = N · 2 / π\n *   OD = PD − 0.5            (slightly different PLD convention than Gates' 0.508)\n *   each slot: 1.2 mm wide tangentially × 0.75 mm deep radially, centered\n *   at the pitch radius.\n */\nfunction run(numberOfTeeth = 20, faceWidth = 6.5, boreDia = 5.0) {\n    const N = Math.max(8, Math.round(numberOfTeeth));\n    const pitch = 2.0;\n    const bottomWidth = 1.2; // tangential slot width\n    const toothDepth = 0.75; // radial slot depth\n    const ODoffset = 0.5; // OD = PD − 0.5\n    const pitchR = (N * pitch) / (2 * Math.PI);\n    const outerR = pitchR - ODoffset / 2; // OD/2\n    // Base disc.\n    let pulley2D = replicad.drawCircle(outerR);\n    // Rectangular tooth slot in its un-rotated frame:\n    //   X axis (radial)    : spans [outerR − toothDepth, outerR + ε]\n    //   Y axis (tangential): spans [−bottomWidth/2, +bottomWidth/2]\n    // ε on the outer side so the cut cleanly breaks the disc boundary.\n    const epsilon = 0.05;\n    const slotLength = toothDepth + epsilon;\n    const slotCenterX = outerR + epsilon / 2 - toothDepth / 2;\n    for (let i = 0; i < N; i++) {\n        const thetaDeg = (i * 360) / N;\n        const slot = replicad\n            .drawRectangle(slotLength, bottomWidth) // centered at origin\n            .translate(slotCenterX, 0) // park it straddling the rim at angle 0\n            .rotate(thetaDeg, [0, 0]); // rotate around centre to position i\n        pulley2D = pulley2D.cut(slot);\n    }\n    // Center bore for the motor shaft.\n    if (boreDia > 0) {\n        pulley2D = pulley2D.cut(replicad.drawCircle(boreDia / 2));\n    }\n    return pulley2D.sketchOnPlane().extrude(faceWidth);\n}\n"
    }
